# ─────────────────────────────────────────────────────────────
# 한국투자증권 KIS Open API 접속 정보
#   1) 이 파일을 복사해 .env 로 저장:  cp .env.example .env
#   2) .env 는 git 에 올라가지 않습니다(.gitignore). 절대 공유/커밋하지 마세요.
#   3) 앱키 발급: https://apiportal.koreainvestment.com  (모의투자 앱키는 별도 발급)
# ─────────────────────────────────────────────────────────────

# 매매 계좌 환경: paper(모의투자) | live(실전)
#   live 로 바꿔도 'python -m trader run --live' + 아래 LIVE_CONFIRM 이 모두 있어야 실제 주문이 나갑니다.
KIS_MODE=paper

# [모의투자] 앱키 / 시크릿 / 계좌번호(앞 8자리) / 상품코드(뒤 2자리, 종합계좌=01)
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_ACCOUNT_PRODUCT=01

# [실전] 앱키 / 시크릿 / 계좌번호 / 상품코드
#   모의투자만 할 때도 채워두면 시세·거래대금순위 조회를 실전 서버에서 합니다
#   (모의투자 서버는 호출 한도가 낮고 순위 조회가 제한될 수 있음). 시세 조회는 주문이 아니므로 안전합니다.
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=
KIS_REAL_ACCOUNT_PRODUCT=01

# 실전 매매 최종 확인 문구 (정확히 이 문장을 넣어야 live 실행 허용)
#   AUTOTRADER_LIVE_CONFIRM=I_ACCEPT_THE_RISK
AUTOTRADER_LIVE_CONFIRM=

# (선택) 텔레그램 알림 — @BotFather 로 봇 생성 후 토큰, 본인 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
